DIARY_PORT=8083
# For Unraid, set this to /mnt/user/appdata/diary
DIARY_DATA_PATH=./data
PUID=99
PGID=100
TZ=America/Los_Angeles
# Set true when accessing exclusively through Tailscale HTTPS.
COOKIE_SECURE=false
# Optional canonical URL if your reverse proxy changes the Host header.
# Example: https://diary.your-tailnet.ts.net (without a trailing path)
APP_ORIGIN=
